# ============================================================================
# Stockflow environment template
# ============================================================================
# WHAT THIS FILE IS FOR:
# Shows every setting the app can read from the environment. Copy this file to
# `.env.local` on your computer (or paste the same names into your host's
# secrets / environment panel) and fill in real values.
#
# HOW TO MAINTAIN:
# - Never put real API keys in THIS file — it is safe to commit.
# - Real secrets go only in `.env.local` (ignored by git) or your host's secret
#   store (Vercel / Railway / Docker `-e` / cloud "Environment variables").
# - After editing `.env.local`, restart `npm run dev` so Next.js reloads them.
# ============================================================================

# Node server bind (used by `next start` / Docker)
PORT=3000
BIND_HOST=0.0.0.0

# Set to 1 to disable Next.js telemetry in CI/containers
NEXT_TELEMETRY_DISABLED=1

# --------------------------------------------------------------------------
# Google Gemini AI (curated inventory report)
# --------------------------------------------------------------------------
# Get a free-tier key: https://aistudio.google.com/apikey
#
# GEMINI_API_USERNAME — label for the Google account that owns the key
#   (helpful for the team; not sent to Google). Example: alicia@freshroute.example
# GEMINI_API_KEY — the secret key from Google AI Studio. KEEP PRIVATE.
# GEMINI_MODEL — optional model id (default works on the free tier).
#
# Hosting: set these same names as environment variables / secrets on the host.
# Do NOT prefix them with NEXT_PUBLIC_ — that would leak the key to the browser.

GEMINI_API_USERNAME=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Future: replace the CSV dataset with department HTTP APIs
# SALES_API_URL=
# INCOMING_API_URL=
# INVENTORY_API_URL=
